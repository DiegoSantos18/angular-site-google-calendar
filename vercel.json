{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "",
  "rewrites": [
    { "source": "/", "destination": "/api/docs" },
    { "source": "/api/docs-assets/(.*)", "destination": "/api/docs?asset=$1" }
  ],
  "functions": {
    "api/docs.ts": {
      "includeFiles": "{public/api-docs.html,public/favicon.png,node_modules/swagger-ui-dist/swagger-ui.css,node_modules/swagger-ui-dist/swagger-ui-bundle.js,node_modules/swagger-ui-dist/swagger-ui-standalone-preset.js}"
    }
  }
}
